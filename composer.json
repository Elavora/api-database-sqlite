{
  "name": "elavora/api-database-sqlite",
  "description": "Extensao SQLite opcional para o framework Elavora",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "ext-pdo_sqlite": "*",
    "elavora/api-database-pdo": "^1.0",
    "elavora/api-framework": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Elavora\\Api\\Extension\\DatabaseSqlite\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  }
}
